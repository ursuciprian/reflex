{
  "version": "rules-v12",
  "note": "Deterministic and authoritative: checked before Jev, enforced even in shadow mode. Patterns are case-insensitive and run over the command plus its context (cwd=, aws_profile=, kube_context=, tf_workspace=, git_branch=). A rule fires when every pattern in `all` matches. `pass` patterns apply per segment: a command passes the fast lane when every segment is read-only or matches one. `applies_to` says what a rule reads: the command (the default) and/or the local scripts the command runs. Script rules run line by line, with the script's simple VAR=value assignments expanded and whole-line comments dropped; `whole_script` rules see the whole body. `context: false` rules read the command without the cwd=/profile context. `tainted` rules apply only in a session whose agent read a suspected prompt injection (guard.mjs); like Jev decisions, they are enforced in enforce mode only.",
  "rules": [
    {
      "id": "secret-read",
      "outcome": "ask",
      "before_read_only": true,
      "rule": "prints the Jev API key or reads a secret store value",
      "all": [
        "(\\$\\{?typesafe_api_key|find-generic-password\\b.*\\s-w|secretsmanager\\s+get-secret-value|ssm\\s+get-parameters?\\b.*--with-decryption)"
      ]
    },
    {
      "id": "secret-file-read",
      "outcome": "ask",
      "before_read_only": true,
      "rule": "reads a private key, a credentials file, a .env file or Kubernetes secrets",
      "all": [
        "(?:^|[;&|(\\n\\x60]|\\$\\(|\\b(?:ba|z|k|da)?sh\\s+-c\\s+['\"]|\\beval\\s+['\"]|\\bssh\\s[^;&|\\n]*?\\s['\"])\\s*(?:(?:then|do|else|!|\\{|sudo|env|nohup|time|command|exec|rtk(?:\\s+proxy)?|timeout\\s+\\S+|xargs(?:\\s+-\\S+)*|\\w+=\\S*)\\s+)*(?:(?:cat|bat|b?less|more|head|tail|grep|egrep|fgrep|rg|ag|base64|xxd|strings|od|hexdump|open|source|\\.|nc|ncat|netcat|socat|tar|zip|gzip|jq|yq|awk|sed|mcp\\s+\\S+)\\s(?:[^;&|\\n'\"]|'[^'\\n]*'|\"[^\"\\n]*\")*?(?:['\"][^'\"\\n]*?)?(?:\\.ssh/id_(?![\\w*?-]*\\.pub\\b)|\\.aws/credentials\\b|\\.(?:netrc|git-credentials|pgpass)\\b|(?<=^|[\\s/'\"=@<:])\\.env(?:\\.(?!(?:example|sample|template|dist|defaults)\\b)[\\w-]+)?(?=$|[\\s'\"),;&|\\x60]))|(?:cp|scp|rsync)\\s(?:[^;&|\\n'\"]|'[^'\\n]*'|\"[^\"\\n]*\")*?(?:['\"][^'\"\\n]*?)?(?:\\.ssh/id_(?![\\w*?-]*\\.pub\\b)|\\.aws/credentials\\b|\\.(?:netrc|git-credentials|pgpass)\\b|(?<=^|[\\s/'\"=@<:])\\.env(?:\\.(?!(?:example|sample|template|dist|defaults)\\b)[\\w-]+)?(?=$|[\\s'\"),;&|\\x60]))\\S*\\s+(?!cwd=)[^\\s;&|]|curl\\b[^;&|\\n]*?\\s(?:-[a-zA-Z]*[dFT]|--data[\\w-]*|--form[\\w-]*|--upload-file|--json)(?:[\\s=]+|(?=['\"@]))['\"]?[^\\s'\";&|]*(?:\\.ssh/id_(?![\\w*?-]*\\.pub\\b)|\\.aws/credentials\\b|\\.(?:netrc|git-credentials|pgpass)\\b|(?<=^|[\\s/'\"=@<:])\\.env(?:\\.(?!(?:example|sample|template|dist|defaults)\\b)[\\w-]+)?(?=$|[\\s'\"),;&|\\x60]))|kubectl\\b[^;&|\\n]*\\sget\\s+(?:-\\S+\\s+(?:[^-\\s]\\S*\\s+)?)*(?:[\\w.]+,)*secrets?(?![\\w-]))|<\\s*['\"]?[^\\s;&|'\"]*(?:\\.ssh/id_(?![\\w*?-]*\\.pub\\b)|\\.aws/credentials\\b|\\.(?:netrc|git-credentials|pgpass)\\b|(?<=^|[\\s/'\"=@<:])\\.env(?:\\.(?!(?:example|sample|template|dist|defaults)\\b)[\\w-]+)?(?=$|[\\s'\"),;&|\\x60]))"
      ]
    },
    {
      "id": "rm-root",
      "outcome": "deny",
      "rule": "recursive delete of / or home",
      "applies_to": [
        "command",
        "script"
      ],
      "all": [
        "\\brm\\s+(-[a-z-]+\\s+)*(--\\s+)?\\\"?(/|~|\\$home|\\$\\{home\\})\\\"?/?\\*?(\\s|$|[;&|)`'\"])"
      ]
    },
    {
      "id": "prod-destroy",
      "outcome": "deny",
      "rule": "destructive operation on production",
      "applies_to": [
        "command",
        "script"
      ],
      "all": [
        "(?<!(non|pre)[-_])\\b(prod(uction)?|prd)(\\d+|\\b|_)(?![\\w.-]*\\.(md|markdown|txt|rst|adoc|org|log|csv|tsv|png|jpe?g|gif|svg|pdf|html?)\\b)|\\b(envs?|environments?|stages?|deploy(ments)?|overlays|accounts|workspaces)/live\\b|(--(env|environment|stage|context|kube-context|profile|workspace|cluster|namespace|target|tier)(=|\\s+)|\\b\\w*(env|environment|stage|profile|context|workspace|tier)=)[\"']?live\\b|\\bworkspace\\s+(select|new)\\s+live\\b|--live(?![\\w-])|\\b(aws_profile|kube_context|tf_workspace)=\\S*\\blive(\\d+|\\b|_)|\\bgit_branch=(\\S*/)?live\\d*(?=\\s|$)",
        "(\\baws\\s+\\S+\\s+(delete|terminate|remove|deregister)-|\\baws\\s+s3\\s+(rm\\b.*--recursive|rb\\b)|\\bkubectl\\b.*\\s(delete|drain)\\s|\\bkubectl\\b.*\\sscale\\b.*--replicas[= ]0\\b|\\bterraform\\s+(-chdir=\\S+\\s+)?(destroy|state\\s+rm|apply\\b.*\\s-(destroy|replace))|\\bhelm\\s+(uninstall|delete)\\s|\\b(drop\\s+(database|table|schema)\\b|truncate\\s+(table\\s+)?[\\w.\"]+\\s*(;|'|\"|$|\\bcascade\\b|\\brestart\\b)|delete\\s+from\\b)|\\b(gcloud|az)\\b.*\\sdelete\\b)"
      ]
    },
    {
      "id": "force-push-main",
      "outcome": "deny",
      "rule": "force push or delete of main/master",
      "applies_to": [
        "command",
        "script"
      ],
      "all": [
        "\\bgit\\s+push\\b[^;&|]*(--force\\b|--force-with-lease\\b|--delete\\b|\\s-[a-zA-Z]*[fd][a-zA-Z]*\\b|\\s\\+|\\s:)",
        "\\b(main|master)\\b"
      ]
    },
    {
      "id": "push-mirror",
      "outcome": "deny",
      "rule": "mirror push rewrites every remote ref",
      "applies_to": [
        "command",
        "script"
      ],
      "all": [
        "\\bgit\\s+push\\b[^;&|]*--mirror\\b"
      ]
    },
    {
      "id": "secret-exfil",
      "outcome": "ask",
      "applies_to": [
        "script"
      ],
      "rule": "script reads credentials or a .env file and talks to the network",
      "whole_script": true,
      "all": [
        "(\\bcat\\b|\\bbase64\\b|\\b(tar|zip|gzip|openssl|scp|rsync)\\b[^\\n]{0,300}|\\bcurl\\b[^\\n]{0,300}(-T|--upload-file|-F|--form|-d|--data[\\w-]*)\\s*[^\\s<@;]{0,100}|<|@)\\s*[\"']?(?<!-i\\s*[\"']?)((~|\\$home|\\$\\{home\\})/\\.(ssh|aws|kube|gnupg)\\b|([^\\s<@;]{0,200}/)?\\.env(?![\\w.]))",
        "\\b(curl|wget|nc|ncat|netcat|socat|scp|rsync|sftp|ftp)\\b|/dev/(tcp|udp)/"
      ]
    },
    {
      "id": "tamper",
      "outcome": "ask",
      "rule": "touches the Reflex gate or agent settings",
      "context": false,
      "applies_to": [
        "command",
        "script"
      ],
      "all": [
        "(/reflex(/|\\s|$)|(\\.local/state|\\.config|xdg_(state|config)_home)\\b[^\\n]{0,200}\\breflex\\b|\\.claude/(settings|hooks)|\\.codex/(hooks\\.json|config\\.toml|rules)|\\.hermes/.*config\\.yaml|opencode/(plugins?|opencode\\.jsonc?)|\\.(pi|omp)/agent/(extensions|settings)|reflex_(mode|allow|guard|judge|queue|checkpoints|engine|setup_dir|data_dir|injection_dir))"
      ]
    },
    {
      "id": "tamper",
      "outcome": "ask",
      "rule": "changes files in an agent settings or hooks directory",
      "all": [
        "cwd=\\S*(\\.claude/(settings|hooks)|\\.codex/(hooks|rules)|\\.hermes/|opencode/plugins?|\\.(pi|omp)/agent/(extensions|settings))"
      ]
    },
    {
      "id": "destroy",
      "outcome": "ask",
      "rule": "destructive operation",
      "applies_to": [
        "command",
        "script"
      ],
      "all": [
        "(\\baws\\s+\\S+\\s+(delete|terminate|remove|deregister)-|\\baws\\s+s3\\s+(rm\\b.*--recursive|rb\\b)|\\bkubectl\\b.*\\s(delete|drain)\\s|\\bkubectl\\b.*\\sscale\\b.*--replicas[= ]0\\b|\\bterraform\\s+(-chdir=\\S+\\s+)?(destroy|state\\s+rm|apply\\b.*\\s-(destroy|replace))|\\bhelm\\s+(uninstall|delete)\\s|\\b(drop\\s+(database|table|schema)\\b|truncate\\s+(table\\s+)?[\\w.\"]+\\s*(;|'|\"|$|\\bcascade\\b|\\brestart\\b)|delete\\s+from\\b)|\\b(gcloud|az)\\b.*\\sdelete\\b)"
      ]
    }
  ],
  "pass": [
    "^(go\\s+(build|test|vet|fmt)|pytest|uv\\s+run\\s+pytest|python3?\\s+-m\\s+(pytest|py_compile)|cargo\\s+(build|test|check|clippy|fmt)|npm\\s+(test|ci|run\\s+(test|lint|build|smoke))|node\\s+--check|bash\\s+-n|terraform\\s+(init|validate|fmt))\\b[^<>`$]*$",
    "^(mkdir|touch)\\s[^<>`$]*$",
    "^chmod\\s+[+u]?x\\s[^<>`$]*$",
    "^git\\s+(add|commit|stash(\\s+push)?|checkout\\s+-b|switch(\\s+-c)?|restore\\s+--staged)\\b[^<>`$]*$",
    "^git\\s+push\\s+(-u\\s+|--set-upstream\\s+)?origin\\s+(?!-)(?!(main|master|release|prod)\\b)[\\w./-]+$",
    "^reflex\\s+(status|queue(\\s+(list|show)(\\s+[\\w-]+)?)?|envelope\\s+show|checkpoints(\\s+list)?)(\\s+--(json|cwd\\s+\\S+|session\\s+\\S+))*\\s*$"
  ],
  "tainted": [
    {
      "id": "tainted-egress",
      "outcome": "ask",
      "rule": "network egress in a session that read a suspected prompt injection",
      "all": [
        "\\b(curl|wget|nc|ncat|netcat|socat|scp|sftp|rsync|ftp|telnet|ssh|xh|httpie)\\b|https?://|\\bgit\\s+(push|send-email|remote\\s+(add|set-url))\\b|\\bgh\\s+(api|gist|issue\\s+(create|comment|edit)|pr\\s+(create|comment|review|edit)|release\\s+(create|upload)|repo\\s+create)\\b|\\b(npm|pnpm|yarn|bun)\\s+publish\\b|\\b(docker|podman)\\s+push\\b|\\baws\\s+s3\\s+(cp|sync|mv)\\b|\\bopen\\s+[\"']?https?:|\\b(python[\\d.]*|node|ruby|perl|php)\\b[^\\n]{0,300}(socket|urllib|requests\\.|fetch\\(|http\\.request|Net::HTTP)"
      ],
      "context": false
    }
  ]
}
