{
  "title": "Reflex: agent tool gate",
  "uid": "reflex",
  "tags": ["reflex", "jev", "agents"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {"from": "now-7d", "to": "now"},
  "templating": {"list": [
    {"name": "datasource", "type": "datasource", "query": "prometheus", "label": "Prometheus"},
    {"name": "user", "type": "query", "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "query": "label_values(reflex_decisions, user)", "includeAll": true, "multi": true, "current": {"text": "All", "value": "$__all"}}
  ]},
  "panels": [
    {"type": "stat", "title": "Judged commands (report window)", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [{"refId": "A", "expr": "sum(reflex_decisions{user=~\"$user\"})"}]},
    {"type": "stat", "title": "Would-be asks + denies", "description": "Decisions that are not pass, in any mode. In shadow mode these are what enforce would have done.",
     "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [{"refId": "A", "expr": "sum(reflex_decisions{user=~\"$user\", decision!=\"pass\"})"}]},
    {"type": "stat", "title": "Jev latency p95", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${datasource}"}, "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [{"refId": "A", "expr": "max(reflex_latency_seconds{user=~\"$user\", quantile=\"0.95\"})"}]},
    {"type": "stat", "title": "Fallbacks (Jev unavailable)", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}},
     "targets": [{"refId": "A", "expr": "sum(reflex_decisions{user=~\"$user\", source=\"fallback\"}) or vector(0)"}]},
    {"type": "barchart", "title": "Decisions by source and outcome", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 9},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "options": {"orientation": "horizontal", "stacking": "normal", "xField": "source"},
     "targets": [{"refId": "A", "instant": true, "format": "table", "legendFormat": "{{decision}}",
                  "expr": "sum by (source, decision) (reflex_decisions{user=~\"$user\"})"}],
     "transformations": [{"id": "groupingToMatrix", "options": {"columnField": "decision", "rowField": "source", "valueField": "Value"}}]},
    {"type": "timeseries", "title": "Decisions over time", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 9},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [{"refId": "A", "expr": "sum by (decision) (reflex_decisions{user=~\"$user\"})", "legendFormat": "{{decision}}"}]},
    {"type": "piechart", "title": "Emitted asks: what humans did", "description": "Enforce mode only. Approved = the command ran after the prompt.",
     "gridPos": {"x": 0, "y": 13, "w": 8, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [{"refId": "A", "instant": true, "expr": "sum by (resolution) (reflex_asks{user=~\"$user\"})", "legendFormat": "{{resolution}}"}]},
    {"type": "timeseries", "title": "Jev latency", "gridPos": {"x": 8, "y": 13, "w": 8, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${datasource}"}, "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [{"refId": "A", "expr": "max by (quantile) (reflex_latency_seconds{user=~\"$user\"})", "legendFormat": "p{{quantile}}"}]},
    {"type": "stat", "title": "Decisions a policy change would flip", "description": "From report.mjs replay of stored answers through the current policy file.",
     "gridPos": {"x": 16, "y": 13, "w": 8, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [{"refId": "A", "expr": "sum(reflex_replay_changes{user=~\"$user\"})"}]}
  ]
}
