#!/usr/bin/env node
// reflex <command>: one entry point for the installed package.
//   reflex check "<cmd>" [--cwd dir] [--intent text]   judge one command
//   reflex report [...]                                what the gate has been doing
//   reflex install [...]                               wire agents (install.mjs flags)
//   reflex uninstall                                   remove every agent's hooks
//   reflex test | eval                                 offline selfchecks | live golden set
//   reflex version
import {spawnSync} from "node:child_process";
import {readFileSync, realpathSync} from "node:fs";
import {dirname, join} from "node:path";
import {fileURLToPath} from "node:url";

const ROOT = join(dirname(realpathSync(fileURLToPath(import.meta.url))), "..");
const [cmd, ...args] = process.argv.slice(2);
const run = (file, extra) => {
  const r = spawnSync(process.execPath, [join(ROOT, file), ...extra], {stdio: "inherit"});
  process.exit(r.status ?? 1);
};

switch (cmd) {
  case "check": run("gate.mjs", ["--check", ...args]); break;
  case "report": run("report.mjs", args); break;
  case "install": run("install.mjs", args.includes("--agent") ? args : ["--agent", "all", ...args]); break;
  case "uninstall": run("install.mjs", ["--agent", "all", "--uninstall", ...args]); break;
  case "eval": run("eval.mjs", args); break;
  case "test": {
    const r = spawnSync("npm", ["test", "--silent"], {cwd: ROOT, stdio: "inherit"});
    process.exit(r.status ?? 1);
  }
  case "version": case "--version": case "-v":
    console.log(JSON.parse(readFileSync(join(ROOT, "package.json"), "utf8")).version); break;
  default:
    console.error("usage: reflex check <cmd> | report | install | uninstall | test | eval | version");
    process.exit(cmd ? 2 : 0);
}
