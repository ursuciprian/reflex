{
  "name": "@ursuciprian/reflex",
  "version": "0.3.0",
  "description": "Risk gate for coding-agent shell commands and an injection guard for what they read: deterministic rules + TypeSafe Jev judgments + an editable policy",
  "keywords": [
    "coding-agents",
    "claude-code",
    "codex",
    "opencode",
    "shell",
    "security",
    "hooks",
    "policy",
    "jev",
    "mcp",
    "prompt-injection"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ursuciprian/reflex#readme",
  "bugs": {
    "url": "https://github.com/ursuciprian/reflex/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "reflex": "bin/reflex"
  },
  "files": [
    "*.mjs",
    "adapters/",
    "bin/",
    "dashboards/",
    "docs/",
    "examples/",
    "router/",
    "routing/",
    "setup/",
    "install.sh",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ursuciprian/reflex.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test.mjs",
    "eval": "node eval.mjs",
    "eval-instructions": "node eval-instructions.mjs",
    "eval-injection": "node guard.mjs --eval",
    "eval-context": "node context.mjs --eval-context",
    "eval-router": "node router/server.mjs --eval",
    "eval-routing": "python3 routing/reflex_router.py --eval",
    "report": "node report.mjs",
    "install-hook": "node install.mjs"
  }
}
