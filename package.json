{
  "name": "@ursuciprian/reflex",
  "version": "0.9.0",
  "description": "Pre-execution risk gate and prompt injection guard for AI coding agents (Claude Code, Codex, opencode, pi, Hermes): deterministic rules, TypeSafe Jev judgments, an editable policy, System 2 escalation and a human approval queue",
  "keywords": [
    "ai-coding-agents",
    "coding-agents",
    "claude-code",
    "claude-code-hooks",
    "codex",
    "codex-cli",
    "opencode",
    "pre-execution-hook",
    "command-approval",
    "guardrails",
    "llm-guardrails",
    "agent-security",
    "prompt-injection",
    "human-in-the-loop",
    "autonomous-agents",
    "devsecops",
    "jev",
    "typesafe",
    "system-one",
    "laya",
    "mcp",
    "hooks",
    "policy",
    "shell",
    "security"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ursuciprian/reflex#readme",
  "bugs": {
    "url": "https://github.com/ursuciprian/reflex/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "reflex": "bin/reflex"
  },
  "files": [
    "*.mjs",
    "adapters/",
    "bin/",
    "dashboards/",
    "docs/",
    "examples/",
    "router/",
    "routing/",
    "setup/",
    "install.sh",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ursuciprian/reflex.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test.mjs",
    "eval": "node eval.mjs",
    "eval-instructions": "node eval-instructions.mjs",
    "eval-injection": "node guard.mjs --eval",
    "eval-ladder": "node eval-ladder.mjs",
    "eval-context": "node context.mjs --eval-context",
    "eval-router": "node router/server.mjs --eval",
    "eval-routing": "python3 routing/reflex_router.py --eval",
    "eval-compare": "node eval-compare.mjs",
    "report": "node report.mjs",
    "install-hook": "node install.mjs"
  }
}
